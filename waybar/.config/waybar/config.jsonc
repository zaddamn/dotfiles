{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["custom/min1", "custom/min2", "custom/min3", "custom/min4"],
    "modules-right": ["memory", "image#wpvol", "pulseaudio", "network", "tray"],
    "hyprland/workspaces": {
        "format": "{id}"
    },


    "custom/min1": {
        "exec": "/home/ZyArch/.config/waybar/minimized.sh 1",
        "return-type": "json",
        "interval": 2,
        "on-click": "/home/ZyArch/.config/waybar/restore.sh 1",
        "tooltip": false
    },

    "custom/min2": {
        "exec": "/home/ZyArch/.config/waybar/minimized.sh 2",
        "return-type": "json",
        "interval": 2,
        "on-click": "/home/ZyArch/.config/waybar/restore.sh 2",
        "tooltip": false
    },

    "custom/min3": {
        "exec": "/home/ZyArch/.config/waybar/minimized.sh 3",
        "return-type": "json",
        "interval": 2,
        "on-click": "/home/ZyArch/.config/waybar/restore.sh 3",
        "tooltip": false
    },

    "custom/min4": {
        "exec": "/home/ZyArch/.config/waybar/minimized.sh 4",
        "return-type": "json",
        "interval": 2,
        "on-click": "/home/ZyArch/.config/waybar/restore.sh 4",
        "tooltip": false
    },

    "memory": {
        "format": "RAM {percentage}%"
    },
    
    "custom/nowplaying": {
    "exec": "~/.config/hypr/scripts/now-playing.sh",
    "interval": 5,
    "max-length": 40
    },
   
    "image#cover": {
    "path": "/tmp/now-playing-cover.jpg",
    "size": 20,
    "interval": 5
    },

    "image#wpvol": {
        "exec": "/home/ZyArch/.config/waybar/vol/wpvol.sh",
        "interval": 10,
        "signal": 8,
        "size": 22,
        "tooltip": true,
        "on-scroll-up": "/home/ZyArch/.config/waybar/vol/wpvol.sh up",
        "on-scroll-down": "/home/ZyArch/.config/waybar/vol/wpvol.sh down",
        "on-click": "/home/ZyArch/.config/waybar/vol/wpvol.sh mute"
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTED",
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "NET {signalStrength}%",
        "format-ethernet": "NET",
        "format-disconnected": "NET OFF"
    },

    "tray": {
        "spacing": 8
    }
}
