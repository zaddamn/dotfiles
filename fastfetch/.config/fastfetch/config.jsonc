{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/gwen-trim.png",
    "width": 24,
    "height": 17,
    "padding": { "top": 0, "left": 1, "right": 3 }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "break",
    "cpu",
    "gpu",
    "memory",
    { "type": "disk", "format": "{1}/{2} ({3}) - {9}" }
  ]
}
