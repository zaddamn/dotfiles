* {
    font: "JetBrainsMono Nerd Font Bold 11";
    background-color: transparent;
    text-color: #cfe3ee;
}

window {
    width: 260px;
    location: center;
    anchor: center;
    background-color: #0a1628ee;
    border: 2px;
    border-color: #2a9dbc;
    border-radius: 10px;
    padding: 10px;
}

mainbox {
    children: [ listview ];
}

listview {
    lines: 4;
    columns: 1;
    spacing: 8px;
    scrollbar: false;
    dynamic: true;
}

element {
    padding: 8px;
    background-color: #0f2238;
    border: 2px;
    border-color: #0f2238;
    border-radius: 8px;
}

element selected.normal {
    border-color: #2a9dbc;
}

element-icon {
    size: 120px;
    horizontal-align: 0;
}

element-text {
    enabled: false;
}
