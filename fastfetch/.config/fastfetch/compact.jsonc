{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/gwen-trim.png",
    "width": 12,
    "height": 8,
    "padding": { "top": 0, "left": 0, "right": 2 }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "wm", "key": "WM" },
    "break",
    { "type": "cpu", "key": "CPU", "format": "{1}" },
    { "type": "memory", "key": "RAM", "format": "{1} / {2}" },
    { "type": "disk", "key": "Disk", "format": "{1} / {2}" }
  ]
}
